@model InstantBot.AdminPanel.Models.DashboardViewModel
@{ViewBag.Title="Dashboard";Layout="_Layout";}
<div class="grid">
  <div class="card"><h3>DAU</h3><div class="val">@Model.Dau</div><small>активных сегодня</small></div>
  <div class="card"><h3>MAU</h3><div class="val">@Model.Mau</div><small>за 30 дней</small></div>
  <div class="card"><h3>Всего</h3><div class="val">@Model.TotalUsers</div><small>пользователей</small></div>
  <div class="card"><h3>Conversion</h3><div class="val">@Model.ConversionRate%</div><small>платящие</small></div>
  <div class="card"><h3>MRR</h3><div class="val">@Model.Mrr ⭐</div><small>Stars/мес</small></div>
  <div class="card"><h3>ARPU</h3><div class="val">@Model.Arpu ⭐</div><small>на пользователя</small></div>
  <div class="card"><h3>Premium</h3><div class="val">@Model.PremiumUsers</div></div>
  <div class="card"><h3>VIP</h3><div class="val">@Model.VipUsers</div></div>
  <div class="card"><h3>LTV (est.)</h3><div class="val">@Model.Ltv ⭐</div></div>
</div>

<div class="chart-box">
  <h2>Новые пользователи — 30 дней</h2>
  <canvas id="usersChart" height="80"></canvas>
</div>
<div class="chart-box">
  <h2>Доход Stars — 30 дней</h2>
  <canvas id="revenueChart" height="80"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
const labels = [@Html.Raw(string.Join(",", Model.Last30Days.Select(d => $"\"{d.Date:dd.MM}\"")))];
const newUsers = [@string.Join(",", Model.Last30Days.Select(d => d.NewUsers))];
const stars    = [@string.Join(",", Model.Last30Days.Select(d => d.StarsSold))];
new Chart(document.getElementById('usersChart'),{type:'line',data:{labels,datasets:[{label:'Новые',data:newUsers,borderColor:'#4f46e5',backgroundColor:'rgba(79,70,229,.08)',fill:true,tension:.3}]}});
new Chart(document.getElementById('revenueChart'),{type:'bar',data:{labels,datasets:[{label:'Stars',data:stars,backgroundColor:'#f59e0b'}]}});
</script>
